<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <ImageView android:id="@+id/ivFinish" android:layout_width="82dp" android:layout_height="82dp" android:background="@drawable/bg_auth_icon" android:contentDescription="Hoàn tất thiết lập" android:padding="20dp" android:src="@drawable/ic_welcome" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Sẵn sàng bắt đầu" android:textColor="@android:color/white" android:textSize="25sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Chọn cách AI giải thích phù hợp nhất với bạn." android:textColor="#C9D8DC" android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardCornerRadius="18dp" app:cardElevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trình độ học tập" android:textColor="#102A3A" android:textSize="13sp" android:textStyle="bold" />
            <Spinner android:id="@+id/spEducationLevel" android:layout_width="match_parent" android:layout_height="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Phong cách giải thích" android:textColor="#102A3A" android:textSize="13sp" android:textStyle="bold" />
            <Spinner android:id="@+id/spExplanationStyle" android:layout_width="match_parent" android:layout_height="48dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
