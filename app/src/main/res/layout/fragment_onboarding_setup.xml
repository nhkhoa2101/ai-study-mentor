<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingBottom="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Thiết lập cá nhân" android:textColor="@android:color/white" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Giúp AI hiểu cách bạn muốn học" android:textColor="#C9D8DC" android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardCornerRadius="18dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trình độ hiện tại" android:textColor="#102A3A" android:textSize="14sp" android:textStyle="bold" />
                <RadioGroup android:id="@+id/rgGrade" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                    <RadioButton android:id="@+id/rbMid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="#138A80" android:text="Lớp 6–9" android:textSize="12sp" />
                    <RadioButton android:id="@+id/rbHigh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="#138A80" android:text="Lớp 10–12" android:textSize="12sp" />
                    <RadioButton android:id="@+id/rbUni" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="#138A80" android:text="Đại học" android:textSize="12sp" />
                </RadioGroup>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#E5ECEB" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Môn học quan tâm" android:textColor="#102A3A" android:textSize="14sp" android:textStyle="bold" />
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:columnCount="3">
                    <CheckBox android:id="@+id/cbMath" android:buttonTint="#138A80" android:text="Toán" android:textSize="12sp" />
                    <CheckBox android:id="@+id/cbPhysics" android:buttonTint="#138A80" android:text="Lý" android:textSize="12sp" />
                    <CheckBox android:id="@+id/cbChemistry" android:buttonTint="#138A80" android:text="Hóa" android:textSize="12sp" />
                    <CheckBox android:id="@+id/cbBiology" android:buttonTint="#138A80" android:text="Sinh" android:textSize="12sp" />
                    <CheckBox android:id="@+id/cbEnglish" android:buttonTint="#138A80" android:text="Anh" android:textSize="12sp" />
                    <CheckBox android:id="@+id/cbLiterature" android:buttonTint="#138A80" android:text="Văn" android:textSize="12sp" />
                    <CheckBox android:id="@+id/cbOther" android:buttonTint="#138A80" android:text="Khác" android:textSize="12sp" />
                </GridLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#E5ECEB" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mục tiêu học tập" app:boxStrokeColor="#138A80">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etGoal" android:layout_width="match_parent" android:layout_height="80dp" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine" android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
