<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_welcome"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_ai_message"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kết quả:"
                android:textColor="#102A3A"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
                
            <TextView
                android:id="@+id/tvAiShortAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phương trình có hai nghiệm: \nx1 = 3 và x2 = -1/2."
                android:textColor="#526A73"
                android:layout_marginBottom="12dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn muốn mình giải thích chi tiết cách giải không? 😊"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:layout_marginBottom="12dp"/>
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <TextView
                    android:id="@+id/btnStepByStep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Giải từng bước"
                    android:textColor="#138A80"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_chip_suggest"
                    android:layout_marginEnd="4dp"/>
                    
                <TextView
                    android:id="@+id/btnShortQuiz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tạo quiz"
                    android:textColor="#138A80"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_chip_suggest"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>

